<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>WorkTimer.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release: one exe in dist\. Self-contained when specified on publish. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>

  <!-- Version resource: Company is shown as the Publisher in Task Manager > Startup apps. -->
  <PropertyGroup>
    <Company>N2K02</Company>
    <Authors>N2K02</Authors>
    <Product>WorkTimer</Product>
    <AssemblyTitle>WorkTimer</AssemblyTitle>
    <Description>Taskbar widget tracker showing the time left in the work day.</Description>
    <Copyright>Copyright © N2K02 2026</Copyright>
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Widget\**\*.cs" />
  </ItemGroup>

</Project>
