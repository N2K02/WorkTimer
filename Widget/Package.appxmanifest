<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="N2K02.WorkTimer.Widget" Publisher="CN=N2K02" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>WorkTimer Widget</DisplayName><PublisherDisplayName>N2K02</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="Widget" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="WorkTimer Widget" Description="Work timer widget tracking work hours on the taskbar."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.widbar.widget" Id="worktimer" PublicFolder="Public" DisplayName="WorkTimer"
                            Description="Work timer widget tracking work hours on the taskbar.">
            <uap3:Properties><WidBarPluginId>com.n2k02.worktimer</WidBarPluginId><WidBarSdkVersion>2</WidBarSdkVersion></uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
